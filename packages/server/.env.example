# --- app ---
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# DEPRECATED break-glass credential. Operators now sign in with a username and
# password (see "built-in auth" below). Leave this empty once an admin exists —
# it is a single all-powerful bearer with no expiry and no attribution, so every
# action it takes lands in the audit log as "root" rather than as a person.
AUTH_TOKEN=
MAX_PROMPT_BYTES=8192
BODY_LIMIT=131072
TRUST_PROXY=0
# Requests allowed per client per window on /run and /drift.
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# --- built-in auth (console login) ---
# Requires DATABASE_URL: users and sessions are rows, so without a database
# there is no login and AUTH_TOKEN above is the only credential.
#
# DW_USER / DW_PASSWORD create the admin account on the FIRST boot against an
# empty database and are ignored on every boot after that — a password changed
# in the console is permanent, and these can be removed from the environment
# once you have signed in. Public sign-up is disabled, so without them there is
# no way in. Minimum 12 characters.
DW_USER=
DW_PASSWORD=
# Signs session cookies. MUST be stable across restarts and identical across
# replicas — changing it signs everyone out at once. Required in production;
# without it a random one is generated in development, with a warning.
#   openssl rand -base64 32
DW_AUTH_SECRET=
# The origin users actually reach this deployment at. Must match the browser's
# address bar (not the container's internal address), or the session cookie is
# scoped to the wrong host and login appears to succeed but never sticks.
DW_BASE_URL=http://localhost:3000

# --- @driftwatch/sdk config (see packages/sdk/src/config/schema.ts) ---
AGENT_MAX_STEPS=8

# --- model client (Qwen Cloud) ---
# Provider selection is code, in exactly one file:
# packages/server/src/config/model-client.ts. This deployment targets Qwen
# Cloud's OpenAI-compatible endpoint; the vars below feed that file.
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=
MODEL=qwen3.6-plus
# Optional cheaper/fallback model Autopilot can switch the agent to when a
# policy fires switch_model (e.g. on a token-spend spike). Setting this both
# registers the model AND becomes the default switch target
# (AUTOPILOT_SWITCH_MODEL_TO). Leave empty to disable model switching.
MODEL_FALLBACK=

# --- telemetry ---
# OTLP/HTTP base endpoint. Traces, metrics AND logs are exported to
# <endpoint>/v1/{traces,metrics,logs}. Point this at your OTel Collector's
# OTLP receiver (default port 4318 for HTTP/proto).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Extra headers on every OTLP export, in the standard k=v,k2=v2 form. Leave
# empty for a self-hosted collector with no auth in front of it; set this if
# your backend needs a header-based ingestion key/token, e.g.:
#   OTEL_EXPORTER_OTLP_HEADERS=x-api-key=<your-key>
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=driftwatch
# Set to 0 to stop attaching raw prompt text / tool-call inputs to spans —
# use this if prompts or tool inputs may carry PII/secrets that shouldn't
# land in the tracing backend. Span/metric names and token counts are
# unaffected either way.
OTEL_CAPTURE_PAYLOADS=1

# --- drift detector (QUERIES data back out; distinct from telemetry ingest) ---
# Base URL of the Prometheus-compatible query API (Prometheus itself, Grafana
# Mimir/Cortex/Thanos, ...) — NOT the OTLP ingest/collector host above. This
# is what the OTel Collector's Prometheus exporter/remote-write exposes for
# querying, or your Prometheus server's own address.
PROMETHEUS_URL=http://localhost:9090
# Optional bearer token, e.g. for Grafana Cloud / Mimir multi-tenant auth.
# Leave empty for a local/self-hosted Prometheus with no auth in front of it.
PROMETHEUS_BEARER_TOKEN=
# Use built-in fixtures instead of querying Prometheus — useful for demos or
# CI before you've generated real traffic.
DRIFT_DRY_RUN=0

# --- inline guardrails (per-request, synchronous — see packages/sdk) ---
# Abort a single agent run once cumulative tokens cross this cap (0 = off).
AGENT_MAX_TOKENS_PER_TASK=0
# Optional USD cap per run, derived from the per-1k-token prices below (0 = off).
AGENT_MAX_COST_USD=0
AGENT_PRICE_PER_1K_INPUT=0
AGENT_PRICE_PER_1K_OUTPUT=0
# What to do when a cap is crossed: stop (halt the loop) | flag (finish, mark it).
AGENT_ON_EXCEED=stop

# --- autopilot (drift-triggered remediation loop) ---
AUTOPILOT_ENABLED=0
# enforce = execute approved actions; shadow = log intended actions only.
AUTOPILOT_MODE=shadow
AUTOPILOT_SCAN_INTERVAL_MS=60000
# Suppress a repeat action for the same signal within this window.
AUTOPILOT_COOLDOWN_MS=300000
# Pending control-action approvals expire to this decision after the timeout.
AUTOPILOT_APPROVAL_TIMEOUT_MS=600000
# Model id an approved switch_model action switches the agent to. Must be a key
# in model-client.ts's registry (i.e. MODEL or MODEL_FALLBACK). Defaults to
# MODEL_FALLBACK, so you usually don't need to set this explicitly.
AUTOPILOT_SWITCH_MODEL_TO=
# Inline JSON policy list, OR point to a file with AUTOPILOT_POLICIES_FILE.
# Example: [{"when":{"severity":"high"},"do":["notify_slack","pause_agent"]}]
# To auto-downshift the model on a cost spike:
#   [{"when":{"tokenSpendDeltaPct":100},"do":["notify_slack","switch_model"]}]
AUTOPILOT_POLICIES=
AUTOPILOT_POLICIES_FILE=

# --- state store ---
# Precedence: DATABASE_URL > REDIS_URL > in-memory.
#
# Postgres is the production backend and the only durable one: agents, API keys,
# the audit log, drift history, approvals and console users all survive a
# restart, and it implements every StateStore method — including the leader lock
# and cooldowns that used to be Redis's reason for being here. The server
# migrates its own schema at boot; there is no separate migration command.
DATABASE_URL=
# Still supported for deployments already running Redis, and for multi-process
# setups with no Postgres. IGNORED when DATABASE_URL is set. Note Redis caps
# history and audit at 500 entries and loses everything on flush.
REDIS_URL=

# --- notification channels ---
SLACK_WEBHOOK_URL=
# Signing secret from your Slack app — verifies interactive button callbacks.
SLACK_SIGNING_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Secret token echoed by Telegram on webhook calls (X-Telegram-Bot-Api-Secret-Token).
TELEGRAM_SECRET_TOKEN=
# Generic webhook that receives the raw drift verdict as JSON.
DRIFT_WEBHOOK_URL=
